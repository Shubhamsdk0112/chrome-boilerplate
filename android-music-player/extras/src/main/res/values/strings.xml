    <!-- ============ Library filter ============ -->
    <string name="filter_title">Filter library</string>
    <string name="filter_explainer">Hides things that are not music — WhatsApp voice notes, call recordings, ringtones, video files — so your library only shows songs.\n\nNothing is ever deleted. Hidden files stay on your phone and you can put any of them back.</string>

    <string name="filter_enable">Hide non-music</string>
    <string name="filter_enable_summary">Turning this off shows everything again straight away</string>

