    <!-- ============ Library filter ============ -->
    <string name="filter_title">Filter library</string>
    <string name="filter_explainer">Hides things that are not music — WhatsApp voice notes, call recordings, ringtones, video files — so your library only shows songs.\n\nNothing is ever deleted. Hidden files stay on your phone and you can put any of them back.</string>

    <string name="filter_enable">Hide non-music</string>
    <string name="filter_enable_summary">Turning this off shows everything again straight away</string>

    <string name="filter_what_to_hide">What counts as junk</string>
    <string name="filter_voice_notes">Voice notes and recordings</string>
    <string name="filter_voice_notes_summary">WhatsApp, Telegram, Signal, call and voice recorders</string>
    <string name="filter_ringtones">Ringtones, alarms and notification sounds</string>
    <string name="filter_video">Video files</string>
    <string name="filter_short">Short untagged clips</string>
    <string name="filter_short_summary">Under 30 seconds with no artist or album. Tagged short tracks are kept.</string>
    <string name="filter_podcasts">Podcasts and audiobooks</string>
    <string name="filter_podcasts_summary">Off by default — these are real audio, just not songs</string>

    <string name="filter_auto">Keep it clean automatically</string>
    <string name="filter_auto_summary">Re-check when new audio appears, so new voice notes never pile up. Only new files are looked at.</string>

    <string name="filter_ai">Ask an AI about the leftovers</string>
    <string name="filter_ai_summary">Only for files the rules above cannot place. Usually a handful.</string>
    <string name="filter_api_key">OpenRouter API key</string>
    <string name="filter_api_key_help">Stored only on this device. Get one at openrouter.ai/keys</string>
    <string name="filter_model">Model</string>
    <string name="filter_model_help">Any OpenRouter model id. Default: %1$s</string>
    <string name="filter_privacy">Only filenames, folders, durations and tags are sent. Your audio never leaves the phone.</string>

